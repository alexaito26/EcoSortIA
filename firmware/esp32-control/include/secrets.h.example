#pragma once

/**
 * Plantilla de credenciales del dispositivo.
 *
 *   1. Copiar este archivo a include/secrets.h
 *   2. Rellenar los valores reales
 *
 * include/secrets.h esta en .gitignore y NUNCA debe subirse al repositorio.
 *
 * El token del dispositivo se genera con el script del monorepo:
 *   pnpm token:generate -- --device ECOSORT-01
 * Se muestra una sola vez; en la base de datos solo queda su hash bcrypt.
 */

// --- WiFi ------------------------------------------------------------------
#define WIFI_SSID "mi-red-wifi"
#define WIFI_PASSWORD "mi-password-wifi"

// --- Supabase --------------------------------------------------------------
// URL base de las Edge Functions, sin barra final.
#define SUPABASE_FUNCTIONS_URL "https://<project-ref>.supabase.co/functions/v1"

// Clave anonima del proyecto (publica: viaja en el header Authorization).
#define SUPABASE_ANON_KEY "eyJhbGciOi..."

// --- Identidad del dispositivo ---------------------------------------------
// Debe coincidir con devices.code en la base de datos.
#define DEVICE_CODE "ECOSORT-01"

// Token secreto del dispositivo (header x-device-token).
#define DEVICE_TOKEN "dev_...."
